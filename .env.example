# Desktop app settings
DISPLAY_CONTROL_LICENSE_SERVER=https://your-license-server.example.com
LICENSE_SERVER_TIMEOUT_SEC=6
DCP_TRIAL_DAYS=14

# Hosted license server settings
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL_DISPLAY_CONTROL=http://127.0.0.1:8200/success
STRIPE_CANCEL_URL_DISPLAY_CONTROL=http://127.0.0.1:8200/cancel
STRIPE_BILLING_PORTAL_RETURN_URL_DISPLAY_CONTROL=https://knightlogics.com

# Optional pricing overrides (cents)
DCP_PRICE_ANNUAL_CENTS=2499
DCP_PRICE_LIFETIME_CENTS=4999

# Hosted license server storage/logging
DCP_LICENSE_LEDGER_FILE=server_runtime/license_ledger.json
DCP_LICENSE_SERVER_LOG=server_runtime/license_server.log

# Recovery email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM=billing@example.com

# Optional local override for legacy recovery token generation
RECOVERY_SIGNING_SECRET=replace_me